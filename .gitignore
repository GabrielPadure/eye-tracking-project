# Python venvs / caches
backend/.venv/
backend/__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Editor / OS
.vscode/
.idea/
.DS_Store

# Benchmark outputs (regenerated on every run)
backend/metrics_*.json
backend/metrics_*.csv

